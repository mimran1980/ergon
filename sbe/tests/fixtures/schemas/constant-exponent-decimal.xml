<?xml version="1.0" encoding="UTF-8"?>
<!-- Decimal composites whose exponent is a constant: the wire carries only
     the mantissa, so a rust_decimal::Decimal must be rescaled to that
     exponent on encode. One negative exponent (fractional places) and one
     positive (hundreds); used at message level and in a group entry. -->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe" package="const_exp" id="91" version="0" byteOrder="littleEndian">
    <types>
        <composite name="messageHeader">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="Decimal9">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8" presence="constant">-9</type>
        </composite>
        <composite name="Hundreds">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8" presence="constant">2</type>
        </composite>
    </types>
    <sbe:message name="Fill" id="1">
        <field name="price" id="1" type="Decimal9"/>
        <field name="notional" id="2" type="Hundreds"/>
        <group name="legs" id="3" dimensionType="groupSizeEncoding">
            <field name="px" id="4" type="Decimal9"/>
        </group>
    </sbe:message>
</sbe:messageSchema>
