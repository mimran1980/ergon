**/src/generated/

# Aeron Cluster test-run node dirs (written into crate CWD by harness tests)
aeron-cluster-[0-9]/
.idea/
.superpowers/
docs/superpowers/
mutants.out*/
.cargo-home/
/release-assets/

# libFuzzer corpus/artifacts: locally-regenerated fuzzing state, not source.
# Grows unboundedly per run; already tracked entries predate this rule and
# are left alone (not untracked) rather than deleted.
sbe/fuzz/corpus/
sbe/fuzz/artifacts/

# Local scratch left at the repo root.
/.playwright-mcp/
/Untitled
/package-lock.json
/docs/research/TODO.md

# Python bytecode (md-dpdk/benches/cloud scripts).
__pycache__/
*.pyc

# Generated by `mdbook-mermaid install .` (just book-deps). Not source.
book/mermaid.min.js
book/mermaid-init.js

# Stray scratch and LLVM profile dumps left at the repo root.
# (Per-run lab bulk is already covered by io/benches/.gitignore.)
/Idle2.java
/Idle2.class
/*.profraw
