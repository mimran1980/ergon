<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ergo ClickHouse persistence recording protocol.

  Registration declarations (SessionStart, RegisterSymbol, RegisterPolicy,
  RegisterLayout) and the per-record DataRecord envelope travel on the wire
  in exactly this encoding. Session-local compact IDs (layout/policy/symbol)
  are assigned by the registration authority; names appear only inside
  registration records, never in data envelopes.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="ergo.persist.recording"
                   id="77"
                   version="0"
                   semanticVersion="1.0.0"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding" description="Repeating group dimensions">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varAsciiEncoding">
            <type name="length" primitiveType="uint32"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>
        <composite name="varBytesEncoding">
            <type name="length" primitiveType="uint32"/>
            <type name="varData" primitiveType="uint8" length="0"/>
        </composite>
        <enum name="RecordKind" encodingType="uint8" description="Payload kind carried by a DataRecord">
            <validValue name="TypedRow">1</validValue>
            <validValue name="RawSbe">2</validValue>
            <validValue name="RawBytes">3</validValue>
        </enum>
        <enum name="TablePolicy" encodingType="uint8" description="Logical table lifetime policy">
            <validValue name="Permanent">1</validValue>
            <validValue name="Temporary">2</validValue>
        </enum>
        <enum name="PayloadEncoding" encodingType="uint8" description="Row payload encoding declared by a layout">
            <validValue name="OrderedRow">1</validValue>
            <validValue name="DynamicRow">2</validValue>
            <validValue name="RawSbe">3</validValue>
            <validValue name="RawBytes">4</validValue>
        </enum>
        <enum name="DeclarationKind" encodingType="uint8" description="Metadata-stream declaration kind">
            <validValue name="SessionStart">1</validValue>
            <validValue name="RegisterSymbol">2</validValue>
            <validValue name="RegisterPolicy">3</validValue>
            <validValue name="RegisterLayout">4</validValue>
            <validValue name="SessionEnd">5</validValue>
        </enum>
    </types>

    <sbe:message name="SessionStart" id="1" description="First declaration of a producer session">
        <field name="runId" id="1" type="uint64"/>
        <field name="startedAtNs" id="2" type="uint64"/>
        <field name="process" id="3" type="varAsciiEncoding"/>
        <field name="instance" id="4" type="varAsciiEncoding"/>
        <field name="build" id="5" type="varAsciiEncoding"/>
    </sbe:message>

    <sbe:message name="RegisterSymbol" id="2" description="Interned repeated string value">
        <field name="symbolId" id="1" type="uint32"/>
        <field name="value" id="2" type="varAsciiEncoding"/>
    </sbe:message>

    <sbe:message name="RegisterPolicy" id="3" description="Versioned retention policy">
        <field name="policyId" id="1" type="uint16"/>
        <field name="temporary" id="2" type="TablePolicy"/>
        <field name="rowTtlNs" id="3" type="uint64"/>
        <field name="idleTtlNs" id="4" type="uint64"/>
    </sbe:message>

    <sbe:message name="RegisterLayout" id="4" description="Ordered column layout bound to a logical table">
        <field name="layoutId" id="1" type="uint16"/>
        <field name="policyId" id="2" type="uint16"/>
        <field name="payloadEncoding" id="3" type="PayloadEncoding"/>
        <field name="schemaFingerprint" id="4" type="uint64"/>
        <field name="projectionRevision" id="5" type="uint32"/>
        <field name="sbeSchemaId" id="6" type="uint16"/>
        <field name="sbeTemplateId" id="7" type="uint16"/>
        <field name="sbeVersion" id="8" type="uint16"/>
        <field name="catalogGeneration" id="9" type="uint32"/>
        <field name="tableName" id="10" type="varAsciiEncoding"/>
        <group name="columns" id="11" dimensionType="groupSizeEncoding">
            <field name="name" id="12" type="varAsciiEncoding"/>
            <field name="typeCode" id="13" type="uint8"/>
            <field name="flags" id="14" type="uint8"/>
            <field name="precision" id="15" type="uint8"/>
            <field name="scale" id="16" type="int8"/>
        </group>
    </sbe:message>

    <sbe:message name="DataRecord" id="5" description="One recorded event envelope">
        <field name="recordKind" id="1" type="RecordKind"/>
        <field name="writerId" id="2" type="uint16"/>
        <field name="layoutId" id="3" type="uint16"/>
        <field name="policyId" id="4" type="uint16"/>
        <field name="sequence" id="5" type="uint64"/>
        <field name="capturedAtNs" id="6" type="uint64"/>
        <field name="catalogGeneration" id="7" type="uint32"/>
        <data name="payload" id="8" type="varBytesEncoding"/>
    </sbe:message>

    <sbe:message name="SessionEnd" id="6" description="Final declaration of a producer session">
        <field name="endedAtNs" id="1" type="uint64"/>
        <field name="finalSequence" id="2" type="uint64"/>
    </sbe:message>
</sbe:messageSchema>
