<?xml version="1.0" encoding="UTF-8"?>
<!--
  Diagnostics SBE schema: internal-state rows for temporary tables
  (book_debug, pipeline_debug, adapter_debug) plus the raw-capture extras
  layout. Generated DTOs carry Persistable impls via the persist codegen
  hook.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="ergo.market.diagnostics"
                   id="89"
                   version="0"
                   semanticVersion="1.0.0"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="varAsciiEncoding">
            <type name="length" primitiveType="uint32"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>
    </types>

    <sbe:message name="BookDebug" id="1">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="updateId" id="2" type="uint64"/>
        <field name="bufferedUpdates" id="3" type="uint32"/>
        <field name="syncState" id="4" type="uint8"/>
        <field name="capturedAtNs" id="5" type="uint64"/>
    </sbe:message>

    <sbe:message name="PipelineDebug" id="2">
        <field name="stage" id="1" type="uint8"/>
        <field name="queued" id="2" type="uint32"/>
        <field name="dropped" id="3" type="uint32"/>
        <field name="capturedAtNs" id="4" type="uint64"/>
    </sbe:message>

    <sbe:message name="AdapterDebug" id="3">
        <field name="reconnectGeneration" id="1" type="uint32"/>
        <field name="receiveSequence" id="2" type="uint64"/>
        <field name="capturedAtNs" id="3" type="uint64"/>
        <data name="note" id="4" type="varAsciiEncoding"/>
    </sbe:message>

    <sbe:message name="ReceiveMetadata" id="4">
        <field name="receiveNs" id="1" type="uint64"/>
        <field name="strategyId" id="2" type="uint32"/>
    </sbe:message>

    <sbe:message name="AeronMetrics" id="5">
        <field name="publisherPosition" id="1" type="uint64"/>
        <field name="recordingPosition" id="2" type="uint64"/>
        <field name="bytesPublished" id="3" type="uint64"/>
        <field name="drops" id="4" type="uint32"/>
        <field name="capturedAtNs" id="5" type="uint64"/>
    </sbe:message>

    <sbe:message name="PipelineMetrics" id="6">
        <field name="rowsIngested" id="1" type="uint64"/>
        <field name="batchesFlushed" id="2" type="uint64"/>
        <field name="checkpoints" id="3" type="uint64"/>
        <field name="schemaConflicts" id="4" type="uint32"/>
        <field name="capturedAtNs" id="5" type="uint64"/>
    </sbe:message>
</sbe:messageSchema>
