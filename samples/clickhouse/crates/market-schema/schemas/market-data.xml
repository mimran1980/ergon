<?xml version="1.0" encoding="UTF-8"?>
<!--
  Market-data SBE schema for the clickhouse sample. Normalized public
  Binance/Bybit events are encoded into these messages by the Python
  recorder via the Rust bridge; the ingester projects them into typed
  ClickHouse tables. Prices/quantities are exact i64 mantissas at the
  declared exponent (1e-8), never floating point.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="ergo.market"
                   id="88"
                   version="0"
                   semanticVersion="1.0.0"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding" description="Repeating group dimensions">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varAsciiEncoding">
            <type name="length" primitiveType="uint32"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>
        <enum name="Side" encodingType="uint8">
            <validValue name="Buy">1</validValue>
            <validValue name="Sell">2</validValue>
            <validValue name="Unknown">0</validValue>
        </enum>
        <enum name="Product" encodingType="uint8">
            <validValue name="Spot">1</validValue>
            <validValue name="Perpetual">2</validValue>
        </enum>
        <enum name="BookFlags" encodingType="uint8">
            <validValue name="None">0</validValue>
            <validValue name="Snapshot">1</validValue>
            <validValue name="EndOfBatch">2</validValue>
            <validValue name="Resync">4</validValue>
        </enum>
    </types>

    <sbe:message name="Trade" id="1">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="price" id="2" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="quantity" id="3" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="side" id="4" type="Side"/>
        <field name="eventTimeNs" id="5" type="uint64"/>
        <field name="exchangeTradeId" id="6" type="uint64"/>
    </sbe:message>

    <sbe:message name="Quote" id="2">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="bidPrice" id="2" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="bidQuantity" id="3" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="askPrice" id="4" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="askQuantity" id="5" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="eventTimeNs" id="6" type="uint64"/>
    </sbe:message>

    <sbe:message name="Bar" id="3">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="intervalSec" id="2" type="uint32"/>
        <field name="open" id="3" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="high" id="4" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="low" id="5" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="close" id="6" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="volume" id="7" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="startTimeNs" id="8" type="uint64"/>
        <field name="closed" id="9" type="uint8"/>
    </sbe:message>

    <sbe:message name="BookDelta" id="4">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="generation" id="2" type="uint32"/>
        <field name="sourceSequence" id="3" type="uint64" presence="optional" nullValue="0"/>
        <field name="flags" id="4" type="BookFlags"/>
        <field name="eventTimeNs" id="5" type="uint64"/>
        <group name="bids" id="6" dimensionType="groupSizeEncoding">
            <field name="price" id="7" type="int64"/>
            <field name="quantity" id="8" type="int64"/>
        </group>
        <group name="asks" id="9" dimensionType="groupSizeEncoding">
            <field name="price" id="10" type="int64"/>
            <field name="quantity" id="11" type="int64"/>
        </group>
    </sbe:message>

    <sbe:message name="Instrument" id="5">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="product" id="2" type="Product"/>
        <field name="tickSize" id="3" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="lotSize" id="4" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="updatedAtNs" id="5" type="uint64"/>
        <data name="symbol" id="6" type="varAsciiEncoding"/>
        <data name="venue" id="7" type="varAsciiEncoding"/>
    </sbe:message>

    <sbe:message name="FundingRate" id="6">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="rate" id="2" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="intervalSec" id="3" type="uint32"/>
        <field name="eventTimeNs" id="4" type="uint64"/>
    </sbe:message>

    <sbe:message name="MarkPrice" id="7">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="price" id="2" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="eventTimeNs" id="3" type="uint64"/>
    </sbe:message>

    <sbe:message name="IndexPrice" id="8">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="price" id="2" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="eventTimeNs" id="3" type="uint64"/>
    </sbe:message>

    <sbe:message name="OpenInterest" id="9">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="interest" id="2" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="eventTimeNs" id="3" type="uint64"/>
    </sbe:message>

    <sbe:message name="Liquidation" id="10">
        <field name="instrumentId" id="1" type="uint32"/>
        <field name="price" id="2" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="quantity" id="3" type="int64" presence="optional" nullValue="-9223372036854775808"/>
        <field name="side" id="4" type="Side"/>
        <field name="eventTimeNs" id="5" type="uint64"/>
    </sbe:message>
</sbe:messageSchema>
