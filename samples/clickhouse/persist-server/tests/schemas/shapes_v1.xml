<?xml version="1.0" encoding="UTF-8"?>
<!-- Every field shape persist supports. v2 adds a field and a group field. -->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe" package="shapes_v1" id="7" version="0" byteOrder="littleEndian">
    <types>
        <composite name="messageHeader">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varString">
            <type name="length" primitiveType="uint32" maxValue="1024"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>
        <type name="Timestamp" primitiveType="uint64" semanticType="UTCTimestamp"/>
        <!-- An exact decimal: mantissa x 10^-9. -->
        <composite name="Decimal9">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8" presence="constant">-9</type>
        </composite>
        <!-- The SBE timestamp composite: milliseconds (FIX TimeUnit 3). -->
        <composite name="TimestampMs" semanticType="UTCTimestamp">
            <type name="time" primitiveType="uint64"/>
            <type name="unit" primitiveType="uint8" presence="constant">3</type>
        </composite>
        <type name="Code" primitiveType="char" length="6"/>
        <enum name="Colour" encodingType="uint8">
            <validValue name="Red">1</validValue>
            <validValue name="Green">2</validValue>
        </enum>
    </types>
    <sbe:message name="Shapes" id="1">
        <field name="ts" id="1" type="Timestamp"/>
        <field name="i8" id="2" type="int8"/>
        <field name="i16" id="3" type="int16"/>
        <field name="i32" id="4" type="int32"/>
        <field name="i64" id="5" type="int64"/>
        <field name="u8" id="6" type="uint8"/>
        <field name="u16" id="7" type="uint16"/>
        <field name="u32" id="8" type="uint32"/>
        <field name="u64" id="9" type="uint64"/>
        <field name="f32" id="10" type="float"/>
        <field name="f64" id="11" type="double"/>
        <field name="optI32" id="12" type="int32" presence="optional"/>
        <field name="optU64" id="13" type="uint64" presence="optional"/>
        <field name="optF64" id="14" type="double" presence="optional"/>
        <field name="colour" id="15" type="Colour"/>
        <field name="code" id="16" type="Code"/>
        <field name="price" id="18" type="Decimal9"/>
        <field name="tsMs" id="19" type="TimestampMs"/>
        <group name="entries" id="20" dimensionType="groupSizeEncoding">
            <field name="qty" id="21" type="int64"/>
            <field name="side" id="22" type="Colour"/>
            <field name="maybe" id="23" type="double" presence="optional"/>
            <field name="px" id="25" type="Decimal9"/>
        </group>
        <data name="note" id="30" type="varString"/>
    </sbe:message>
</sbe:messageSchema>
