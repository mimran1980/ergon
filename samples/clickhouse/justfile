# ClickHouse persistence lab. Run from samples/clickhouse/. These recipes work
# on whichever cluster LAB_CONTEXT names; making and removing a cluster is per
# platform:
#
#   just mac up|stop|start|destroy                kind on this machine (mac.justfile)
#   just azure up|sync|on|pause|resume|stop|start|status|down
#                                                 VMs on Azure (azure.justfile)
#
#   just up         build the images, apply the manifests, wait (the cluster exists)
#   just deploy     apply kustomization.yaml (deploy/, config/): after editing config/ or deploy/
#   just watch-config  publish config/ to the pods on every save
#   just md         rebuild + restart the feed handlers, engines and ingesters after a code/schema change
#   just aeron      rebuild + restart Aeron (the driver, docker/aeron.Dockerfile), then its clients
#   just ingester   restart the ingesters: they reload every schema in schema/
#   just logs       follow the feed handler, engine, ingester and Aeron logs
#   just verify     check the running lab end to end
#   just test       unit + integration tests (throwaway ClickHouse + Aeron archive driver)
#   just test-stop  stop that throwaway ClickHouse and driver
#   just latency    time recording on the app thread
#   just engine-fixtures [--check]  regenerate (or check) the engine's replay fixtures

set dotenv-load

mod mac 'mac.justfile'
mod azure 'azure.justfile'

cluster := "clickhouse-lab"
build_jobs := "1"
test_threads := "2"
# kind by default; LAB_CONTEXT=lab-vms is the k3s cluster of `just azure up`.
context := env("LAB_CONTEXT", "kind-" + cluster)
kube := "kubectl --context " + context + " -n lab"

[private]
default:
    @just --list

# Build images, deploy, wait, print URLs: on a cluster that exists
# (`just mac up` makes kind's; on Azure, `just azure on up`).
# Build images, deploy and wait, on a cluster that exists
up: images deploy
    {{kube}} rollout status statefulset/clickhouse --timeout=300s
    {{kube}} rollout status deploy/grafana deploy/jupyter daemonset/aeron daemonset/ingester --timeout=300s
    for d in $({{kube}} get deploy -l 'app in (md,engine,exch-sim)' -o name); do {{kube}} rollout status $d --timeout=300s; done
    @just urls

# Apply everything kustomization.yaml lists: deploy/ and config/. A change
# to config/ alone changes only the ConfigMap `lab-config`: the pods see it
# at the kubelet's next sync, within about a minute, and apply it with no
# restart. `just config` gets it there in seconds.
# Server-side apply, so a field taken out of deploy/ is taken out of the
# cluster too. Apply kustomization.yaml.
# Apply kustomization.yaml: deploy/ and config/
deploy:
    #!/usr/bin/env bash
    set -euo pipefail
    kubectl --context {{context}} apply -k . --server-side --field-manager=lab | { grep -v unchanged || true; }

# Changing a pod's annotation makes the kubelet sync that pod now, which
# refreshes its ConfigMap volume. It restarts nothing. Under Flux nothing
# does this, so the kubelet's own sync (about a minute) applies.
# Publish config/ and have the pods see it in seconds.
config: deploy
    {{kube}} annotate pod --all --overwrite lab/config="$(cat config/* | cksum | cut -d' ' -f1)" >/dev/null

# Run `just config` whenever a file in config/ changes. Ctrl-C to stop.
watch-config:
    #!/usr/bin/env bash
    last=$(cat config/* | cksum)
    while sleep 1; do
        now=$(cat config/* | cksum)
        [[ $now == "$last" ]] && continue
        last=$now
        just config && echo "$(date +%T) config/ published"
    done

# Not what `just up` does: four kind nodes on one machine cannot spare a core per thread.
# Apply the lab, then deploy/spin/: spinning threads, one core each.
spin: deploy
    #!/usr/bin/env bash
    set -euo pipefail
    kube=(kubectl --context {{context}} -n lab)
    patch() {
        local kind="$1" selector="$2" file="$3" name
        for name in $("${kube[@]}" get "$kind" -l "$selector" -o name); do
            "${kube[@]}" patch "$name" --type strategic --patch-file "$file"
        done
    }
    patch deployment app=engine deploy/spin/engine.yaml
    patch deployment app=exch-sim deploy/spin/exch-sim.yaml
    patch deployment app=md deploy/spin/md.yaml
    "${kube[@]}" patch daemonset/aeron --type strategic --patch-file deploy/spin/aeron.yaml


# Reachable from other machines too: every port listens on 0.0.0.0.
# Print the UIs' URLs
urls:
    #!/usr/bin/env bash
    if [[ {{context}} == kind-* ]]; then
        host=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || hostname -I 2>/dev/null | cut -d' ' -f1)
        host=${host:-localhost} clickhouse=8123 grafana=3000 jupyter=8888
    else
        # No kind port mapping: the NodePorts, on any node.
        read -r host _ <<<"$LAB_VM_IPS"
        clickhouse=30123 grafana=30300 jupyter=30888
    fi
    echo "ClickHouse UI  http://$host:$clickhouse/play   (user lab / password lab)"
    echo "Grafana        http://$host:$grafana"
    echo "JupyterLab     http://$host:$jupyter/lab/tree/verify.ipynb"
    echo "Feeds          $({{kube}} get deploy -l app=md -o jsonpath='{.items[*].metadata.labels.exchange}')"
    echo "Engines        $({{kube}} get deploy -l app=engine -o jsonpath='{.items[*].metadata.labels.region}')"
    echo "Config         $PWD/config/  (\`just config\` or \`just watch-config\` publishes edits live)"

# Build every image and load it into the cluster
images: build
    docker build -q -t lab/jupyter:local -f docker/jupyter.Dockerfile docker
    docker build -q -t lab/aeron:local -f docker/aeron.Dockerfile docker
    just _load lab/jupyter:local
    just _load lab/aeron:local
    just _load lab/app:local

# `kind load docker-image` fails on Docker's containerd image store
# ("content digest … not found"), so import a single-platform save directly.
# Into every node: a pod can land on any of them.
_load image:
    #!/usr/bin/env bash
    set -euo pipefail
    tar=$(mktemp)
    docker save --platform linux/$(docker version -f '{{{{.Server.Arch}}') {{image}} > "$tar"
    if [[ {{context}} == kind-* ]]; then
        for node in $(kind get nodes --name {{cluster}}); do
            docker exec -i "$node" ctr -n k8s.io images import --all-platforms - < "$tar"
        done
    else
        nodes=$(kubectl --context {{context}} get nodes -o jsonpath='{.items[*].status.addresses[?(@.type=="InternalIP")].address}')
        test -n "$nodes"
        for node in $nodes; do
            ssh -o BatchMode=yes "$node" sudo k3s ctr -n k8s.io images import - < "$tar"
        done
    fi
    rm -f "$tar"

# Compile the lab's binaries for Linux; build their image with the schema.
# One compile job: NautilusTrader's crates take gigabytes each to build, and
# the Docker VM shares the machine with the running lab. Raise it with
# `just build_jobs=8 build` on a machine with memory to spare.
# Compile the lab's Linux binaries and build their image
build:
    docker build -q -t lab/builder:local -f docker/builder.Dockerfile docker
    docker run --rm -v "$PWD/../..":/src -w /src/samples/clickhouse \
        -v lab-cargo-registry:/usr/local/cargo/registry -v lab-cargo-target:/target \
        -e CARGO_TARGET_DIR=/target -e CARGO_BUILD_JOBS={{build_jobs}} \
        -e CMAKE_BUILD_PARALLEL_LEVEL={{build_jobs}} lab/builder:local \
        sh -c 'RUSTUP_TOOLCHAIN=1.98.1 CARGO_TARGET_DIR=/target-runtime cargo build --release --manifest-path /src/Cargo.toml -p ergon-runtime-server --bin ingester && cargo build --release -p md -p aeron-driver -p engine --bins && mkdir -p target/linux/schema \
            && cp /target-runtime/release/ingester /target/release/md /target/release/aeron-driver /target/release/engine /target/release/exch-sim target/linux/ \
            && cp schema/*.xml target/linux/schema/'
    docker build -q -t lab/app:local -f docker/app.Dockerfile target/linux

# Rebuild and restart the feed handlers, engines and ingesters (after changing a schema or code).
md: build
    just _load lab/app:local
    # The ingesters first: a new one understands what new feed handlers send.
    {{kube}} rollout restart daemonset/ingester
    {{kube}} rollout status daemonset/ingester --timeout=120s
    {{kube}} rollout restart deploy -l 'app in (md,engine,exch-sim)'
    for d in $({{kube}} get deploy -l 'app in (md,engine,exch-sim)' -o name); do {{kube}} rollout status $d --timeout=300s; done

# The clients are restarted too, so they join the new driver at once rather
# than after their 30 s timeout.
# Rebuild and restart Aeron and its clients (after changing the driver or docker/aeron.Dockerfile).
aeron:
    just build
    just _load lab/app:local
    docker build -q -t lab/aeron:local -f docker/aeron.Dockerfile docker
    just _load lab/aeron:local
    {{kube}} rollout restart daemonset/aeron
    {{kube}} rollout status daemonset/aeron --timeout=120s
    {{kube}} rollout restart daemonset/ingester
    {{kube}} rollout restart deploy -l 'app in (md,engine,exch-sim)'
    {{kube}} rollout status daemonset/ingester --timeout=120s
    for d in $({{kube}} get deploy -l 'app in (md,engine,exch-sim)' -o name); do {{kube}} rollout status $d --timeout=300s; done

# Restart the ingesters; they resume from their checkpoints. Schema changes are `just md`.
ingester:
    {{kube}} rollout restart daemonset/ingester
    {{kube}} rollout status daemonset/ingester --timeout=120s

# Follow the feeds', engines', ingesters' and Aeron's logs
logs:
    {{kube}} logs -f -l 'app in (md,engine,exch-sim,ingester,aeron)' --prefix --max-log-requests 30 --tail 20

# End-to-end checks against the running lab.
verify:
    ./scripts/verify.sh

# Unit + integration tests; starts a throwaway ClickHouse and Aeron archive driver.
test: _test-clickhouse _test-aeron
    bash scripts/test-cluster-lifecycle.sh
    bash scripts/test-azure.sh
    bash scripts/test-test-service-memory.sh
    cargo test --workspace -- --test-threads={{test_threads}}

_test-clickhouse:
    #!/usr/bin/env bash
    set -euo pipefail
    # Recreate only this disposable container when its memory settings change.
    settings=$(cat deploy/infra/clickhouse.xml deploy/infra/clickhouse-users.xml | cksum | awk '{print $1 "-" $2}')
    settings="memory-v1-$settings"
    current=$(docker inspect --format '{{{{index .Config.Labels "lab.test-settings"}}' persist-test-clickhouse 2>/dev/null || true)
    running=$(docker inspect --format '{{{{.State.Running}}' persist-test-clickhouse 2>/dev/null || true)
    if [[ $current != "$settings" || $running != true ]]; then
        docker rm -f persist-test-clickhouse >/dev/null 2>&1 || true
        docker run -d --name persist-test-clickhouse -p 18123:8123 --ulimit nofile=262144:262144 \
            --memory=1280m --memory-swap=1280m --cpus=2 --label "lab.test-settings=$settings" \
            -v "$PWD/deploy/infra/clickhouse.xml:/etc/clickhouse-server/config.d/lab.xml:ro" \
            -v "$PWD/deploy/infra/clickhouse-users.xml:/etc/clickhouse-server/users.d/lab.xml:ro" \
            -e CLICKHOUSE_USER=lab -e CLICKHOUSE_PASSWORD=lab -e CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1 \
            clickhouse/clickhouse-server:25.8 >/dev/null
    fi
    deadline=$((SECONDS + 120))
    for ((attempt=0; attempt<120 && SECONDS<deadline; attempt++)); do
        timeout=$((deadline - SECONDS))
        if ((timeout > 2)); then timeout=2; fi
        curl -sf --connect-timeout 1 --max-time "$timeout" http://localhost:18123/ping >/dev/null && exit 0
        [[ $(docker inspect --format '{{{{.State.Running}}' persist-test-clickhouse) == true ]] || break
        if ((SECONDS < deadline)); then sleep 1; fi
    done
    docker logs --tail 40 persist-test-clickhouse >&2
    echo 'test ClickHouse did not become ready within 120 seconds' >&2
    exit 1

# Stop the throwaway ClickHouse and Aeron driver that `just test` leaves running.
test-stop:
    docker rm -f persist-test-clickhouse
    pkill -f 'aeron.dir=/tmp/persist-test-aeron' || true

# Media driver + archive in one JVM. The tests use /tmp/persist-test-aeron;
# 1 MiB segments so they see purges. Cap the JVM on the host too; an old
# uncapped test driver is restarted once to pick up the heap limit.
_test-aeron: _aeron-jar
    #!/usr/bin/env bash
    set -euo pipefail
    # A driver whose directory is gone (macOS cleans /tmp) is no driver.
    if [[ ! -f /tmp/persist-test-aeron/cnc.dat ]] || ! pgrep -f 'Xmx128m.*aeron.dir=/tmp/persist-test-aeron' >/dev/null; then
        pkill -f 'aeron.dir=/tmp/persist-test-aeron' || true
        touch target/aeron-test.started
        sleep 1 # `-nt` compares whole seconds
        nohup java -Xms32m -Xmx128m -XX:MaxDirectMemorySize=64m -XX:+UseSerialGC \
            -XX:ReservedCodeCacheSize=32m -XX:MaxMetaspaceSize=64m -Xss512k \
            --add-opens java.base/jdk.internal.misc=ALL-UNNAMED -cp {{aeron_jar}} \
            -Daeron.dir=/tmp/persist-test-aeron -Daeron.dir.delete.on.start=true \
            -Daeron.archive.dir=target/aeron-test-archive -Daeron.archive.segment.file.length=1m \
            -Daeron.archive.control.channel='aeron:udp?endpoint=localhost:18010' \
            -Daeron.archive.replication.channel='aeron:udp?endpoint=localhost:0' \
            io.aeron.archive.ArchivingMediaDriver > target/aeron-test.log 2>&1 &
        for ((attempt=0; attempt<600; attempt++)); do
            [[ /tmp/persist-test-aeron/cnc.dat -nt target/aeron-test.started ]] && exit 0
            pgrep -f 'Xmx128m.*aeron.dir=/tmp/persist-test-aeron' >/dev/null || break
            sleep 0.2
        done
        tail -n 40 target/aeron-test.log >&2
        echo 'test Aeron driver did not become ready within 120 seconds' >&2
        exit 1
    fi

aeron_version := "1.52.2"
aeron_jar := "target/aeron-all-" + aeron_version + ".jar"

_aeron-jar:
    @mkdir -p target
    @[ -f {{aeron_jar}} ] || curl -sfLo {{aeron_jar}} \
        https://repo1.maven.org/maven2/io/aeron/aeron-all/{{aeron_version}}/aeron-all-{{aeron_version}}.jar

# Time recording on the app thread: SBE, tracing on and off, and a control.
latency: _test-clickhouse _test-aeron
    for arm in control control-x100 sbe installed uninstalled event value value-nested event-off no-table counter gauge histogram counter-event gauge-event histogram-event clock-now clock-cached system-time poll-idle poll-due trace-off trace-unsampled trace-sampled span-off span-on; do \
        cargo run -q --release --manifest-path ../../Cargo.toml -p ergon-runtime-server --example record_latency -- $arm; done

# Clippy and rustfmt for the sample
lint:
    cargo clippy --workspace --all-targets -- -D warnings
    cargo fmt --check

# Regenerate the engine's replay input and golden output; `--check` fails
# when the checked-in ones no longer match the generator and the engine.
engine-fixtures *args:
    cargo run -q -p engine --example replay_fixtures -- {{args}}

# Engine and venue on one thread; the default synthetic fixture needs no services.
# Pass --source archive|clickhouse --from EPOCH_NS --to EPOCH_NS for lab history.
backtest *args:
    cargo run -q -p engine --features clickhouse --bin backtest -- {{args}}
