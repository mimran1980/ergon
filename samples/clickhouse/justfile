# ClickHouse persistence lab. Run from samples/clickhouse/.
#
#   just up         create the kind cluster and run everything
#   just recorder   rebuild + redeploy the recorder after a code/schema change
#   just logs       follow the recorder log
#   just verify     check the running lab end to end
#   just test       unit + ClickHouse integration tests
#   just stop / just start   pause the cluster, keeping data
#   just destroy    delete the cluster and its data

cluster := "clickhouse-lab"

default:
    @just --list

# Create the cluster (if needed), build images, deploy, wait, print URLs.
up: _cluster images
    kubectl --context kind-{{cluster}} apply -f deploy/lab.yaml
    kubectl --context kind-{{cluster}} -n lab rollout status statefulset/clickhouse --timeout=300s
    kubectl --context kind-{{cluster}} -n lab rollout status deploy/grafana deploy/jupyter deploy/recorder --timeout=300s
    @just urls

urls:
    @echo "ClickHouse UI  http://localhost:8123/play   (user lab / password lab)"
    @echo "Grafana        http://localhost:3000"
    @echo "JupyterLab     http://localhost:8888/lab/tree/verify.ipynb"
    @echo "Config         $PWD/config/tables.yaml  (edits apply live)"

_cluster:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! kind get clusters | grep -qx {{cluster}}; then
        sed "s|LAB_DIR|$PWD|" deploy/kind.yaml | kind create cluster --config -
    fi

images: build-recorder
    docker build -q -t lab/jupyter:local -f deploy/jupyter.Dockerfile deploy
    just _load lab/jupyter:local
    just _load lab/recorder:local

# `kind load docker-image` fails on Docker's containerd image store
# ("content digest … not found"), so import a single-platform save directly.
_load image:
    docker save --platform linux/$(docker version -f '{{{{.Server.Arch}}') {{image}} \
        | docker exec -i {{cluster}}-control-plane ctr -n k8s.io images import --all-platforms -

# Compile the recorder for Linux (cached volumes) and build its image.
build-recorder:
    docker run --rm -v "$PWD/../..":/src -w /src/samples/clickhouse \
        -v lab-cargo-registry:/usr/local/cargo/registry -v lab-cargo-target:/target \
        -e CARGO_TARGET_DIR=/target rust:1.98.1-bookworm \
        sh -c 'cargo build --release -p recorder && mkdir -p target/linux && cp /target/release/recorder target/linux/'
    docker build -q -t lab/recorder:local -f deploy/recorder.Dockerfile target/linux

# Rebuild and restart the recorder (after changing schema/market.xml or code).
recorder: build-recorder
    just _load lab/recorder:local
    kubectl --context kind-{{cluster}} -n lab rollout restart deploy/recorder
    kubectl --context kind-{{cluster}} -n lab rollout status deploy/recorder --timeout=120s

logs:
    kubectl --context kind-{{cluster}} -n lab logs -f deploy/recorder

# Run the recorder on this machine instead (writes to the lab's ClickHouse).
run:
    kubectl --context kind-{{cluster}} -n lab scale deploy/recorder --replicas=0
    cargo run --release -p recorder

# End-to-end checks against the running lab.
verify:
    ./scripts/verify.sh

# Unit tests plus integration tests against a throwaway ClickHouse container.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! docker ps --format '{{{{.Names}}' | grep -qx persist-test-clickhouse; then
        docker rm -f persist-test-clickhouse >/dev/null 2>&1 || true
        docker run -d --name persist-test-clickhouse -p 18123:8123 --ulimit nofile=262144:262144 \
            -e CLICKHOUSE_USER=lab -e CLICKHOUSE_PASSWORD=lab -e CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1 \
            clickhouse/clickhouse-server:25.8 >/dev/null
        until curl -sf http://localhost:18123/ping >/dev/null; do sleep 1; done
    fi
    cargo test --workspace

# Time persist.record() on the app thread, beside a timing-only control.
latency:
    cargo run -q --release -p persist --example record_latency -- control
    cargo run -q --release -p persist --example record_latency

lint:
    cargo clippy --workspace --all-targets -- -D warnings
    cargo fmt --check

stop:
    docker stop {{cluster}}-control-plane

start:
    docker start {{cluster}}-control-plane

# Deletes the cluster, including all recorded data.
destroy:
    kind delete cluster --name {{cluster}}
