AERON_DIR=/mnt/huge-aeron/aeron
AERON_CLIENT_PRE_TOUCH_MAPPED_MEMORY=true
AERON_TERM_BUFFER_SPARSE_FILE=false
LL_MSG_BYTES=32
LL_WARMUP=100000
# The run is bounded by time, not by count: LL_SAMPLES is a ceiling no path
# here reaches in LL_DURATION_S (1 us a round trip would take 100 s), so the
# ping is still measuring for the whole verify.sh window
# (tests/manifests.rs checks both).
LL_SAMPLES=100000000
LL_RATE=0
LL_PING_STREAM=1001
LL_PONG_STREAM=1002
LL_LOG_LEVEL=info
LL_LOG_QUEUE_LINES=4096
LL_DRIVER_WAIT_S=60
LL_CONNECT_WAIT_S=120
ERGON_HOST_CHECKS=on
LL_DURATION_S=90
# what the report records as transport= (the driver selects it; apps only print it)
RUSTERON_MEDIA_DRIVER_TRANSPORT=dpdk-ena
