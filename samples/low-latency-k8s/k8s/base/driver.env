AERON_DIR=/mnt/huge-aeron/aeron
RUSTERON_MEDIA_DRIVER_DIR=/mnt/huge-aeron/aeron
AERON_DIR_DELETE_ON_START=true
AERON_FILE_PAGE_SIZE=2097152
AERON_TERM_BUFFER_SPARSE_FILE=false
AERON_RCV_INITIAL_WINDOW_LENGTH=2097152
AERON_SOCKET_SO_RCVBUF=2097152
AERON_SOCKET_SO_SNDBUF=2097152
AERON_RECEIVER_IO_VECTOR_CAPACITY=16
RUSTERON_DPDK_HUGE_DIR=/dev/hugepages
RUSTERON_DPDK_EPHEMERAL_PORT_RANGE=61000 63999
ERGON_HOST_CHECKS=on
