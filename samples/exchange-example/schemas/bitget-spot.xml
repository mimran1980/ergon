<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.upex.stream.sbe"
                   id="1"
                   version="3"
                   semanticVersion="1.0.0"
                   description="Bitget Spot/Market SBE schema"
                   byteOrder="littleEndian">
    <types>
        <type name="timestamp_t" primitiveType="uint64"/>
        <type name="price_t" primitiveType="int64"/>
        <type name="size_t" primitiveType="int64"/>
        <type name="sequence_t" primitiveType="uint64"/>
        <type name="exponent_t" primitiveType="int8"/>
        <type name="symbol_t" primitiveType="char" length="24"/>

        <composite name="messageHeader" description="Standard SBE header">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>

        <composite name="groupSize16Encoding" description="Repeating group dimensions">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>

        <composite name="varString8Encoding">
            <type name="length" primitiveType="uint8"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>

        <composite name="padding0" />
        <composite name="padding5">
            <type name="pad" primitiveType="uint8" length="5"/>
        </composite>
        <composite name="padding7">
            <type name="pad" primitiveType="uint8" length="7"/>
        </composite>

        <enum name="tradeSide" encodingType="uint8">
            <validValue name="Buy">0</validValue>
            <validValue name="Sell">1</validValue>
        </enum>

        <enum name="instCategory" encodingType="uint8">
            <validValue name="Spot">0</validValue>
            <validValue name="UsdtFutures">1</validValue>
            <validValue name="CoinFutures">2</validValue>
            <validValue name="UsdcFutures">3</validValue>
        </enum>
    </types>

    <!-- Depth50: full orderbook snapshot, 20ms updates -->
    <sbe:message name="Depth50" id="1001" description="50-level depth orderbook snapshot">
        <field name="ts" id="1" type="timestamp_t"/>
        <field name="seq" id="2" type="sequence_t"/>
        <field name="priceExponent" id="3" type="exponent_t"/>
        <field name="sizeExponent" id="4" type="exponent_t"/>
        <field name="sts" id="5" type="timestamp_t"/>
        <field name="category" id="6" type="instCategory"/>
        <field name="padding" id="7" type="padding5"/>
        <group name="asks" id="200" dimensionType="groupSize16Encoding">
            <field name="price" id="201" type="price_t"/>
            <field name="size" id="202" type="size_t"/>
        </group>
        <group name="bids" id="300" dimensionType="groupSize16Encoding">
            <field name="price" id="301" type="price_t"/>
            <field name="size" id="302" type="size_t"/>
        </group>
        <data name="symbol" id="400" type="varString8Encoding"/>
    </sbe:message>

    <!-- BestBidAsk: top-of-book -->
    <sbe:message name="BestBidAsk" id="1002" description="Best bid/ask">
        <field name="ts" id="1" type="timestamp_t"/>
        <field name="bid1Price" id="2" type="price_t"/>
        <field name="bid1Size" id="3" type="size_t"/>
        <field name="ask1Price" id="4" type="price_t"/>
        <field name="ask1Size" id="5" type="size_t"/>
        <field name="priceExponent" id="6" type="exponent_t"/>
        <field name="sizeExponent" id="7" type="exponent_t"/>
        <field name="seq" id="8" type="sequence_t"/>
        <field name="sts" id="9" type="timestamp_t"/>
        <field name="category" id="10" type="instCategory"/>
        <field name="padding" id="11" type="padding5"/>
        <data name="symbol" id="400" type="varString8Encoding"/>
    </sbe:message>

    <!-- Trade: public trade data -->
    <sbe:message name="Trade" id="1003" description="Public trade">
        <field name="priceExponent" id="1" type="exponent_t"/>
        <field name="sizeExponent" id="2" type="exponent_t"/>
        <field name="sts" id="3" type="timestamp_t"/>
        <field name="category" id="4" type="instCategory"/>
        <field name="padding" id="5" type="padding5"/>
        <group name="trades" id="200" dimensionType="groupSize16Encoding">
            <field name="ts" id="201" type="timestamp_t"/>
            <field name="execId" id="202" type="sequence_t"/>
            <field name="price" id="203" type="price_t"/>
            <field name="size" id="204" type="size_t"/>
            <field name="side" id="205" type="tradeSide"/>
            <field name="padding" id="206" type="padding7"/>
        </group>
        <data name="symbol" id="400" type="varString8Encoding"/>
    </sbe:message>
</sbe:messageSchema>
