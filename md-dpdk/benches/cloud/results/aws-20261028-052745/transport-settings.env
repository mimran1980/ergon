# transport_collect.py: transport-settings.tr.env's sysctls (host.sh transport_sysctls),
# each the value every host must read back at every point; an optional one no host's
# kernel had at any point is declared absent
shared.net.ipv4.tcp_congestion_control=cubic
shared.net.ipv4.tcp_sack=1
shared.net.ipv4.tcp_timestamps=1
shared.net.ipv4.tcp_slow_start_after_idle=0
shared.net.ipv4.tcp_rmem=4096 1048576 16777216
shared.net.ipv4.tcp_wmem=4096 1048576 16777216
shared.net.core.rmem_max=16777216
shared.net.core.wmem_max=16777216
shared.net.core.busy_read=50
shared.net.core.busy_poll=50
shared.net.ipv4.tcp_rto_min_us=8000
shared.net.ipv4.tcp_delack_max_us=absent
# each arm's per-arm knobs as it ran them (transport-settings.env's list); a sweep
# line names the arms a tuning session swept for one (TR_TUNED_SWEPT, its variants)
aeron-rel.knob.aeron_driver=external
aeron-rel.knob.aeron_page=4096
aeron-rel.knob.aeron_path=kernel-busy
aeron-rel.knob.aeron_so_rcvbuf=2097152
aeron-rel.knob.aeron_threading=DEDICATED
aeron-rel.knob.nak_delay_ns=1000
aeron-rel.knob.napi_defer=0
aeron-rel.knob.term_length=1048576
aeron-rel-emb.knob.aeron_driver=embedded
aeron-rel-emb.knob.aeron_page=4096
aeron-rel-emb.knob.aeron_path=kernel-busy
aeron-rel-emb.knob.aeron_so_rcvbuf=2097152
aeron-rel-emb.knob.aeron_threading=DEDICATED
aeron-rel-emb.knob.nak_delay_ns=1000
aeron-rel-emb.knob.napi_defer=0
aeron-rel-emb.knob.term_length=1048576
aeron-rel-invoker.knob.aeron_driver=embedded
aeron-rel-invoker.knob.aeron_page=4096
aeron-rel-invoker.knob.aeron_path=kernel-busy
aeron-rel-invoker.knob.aeron_so_rcvbuf=2097152
aeron-rel-invoker.knob.aeron_threading=INVOKER
aeron-rel-invoker.knob.nak_delay_ns=1000
aeron-rel-invoker.knob.napi_defer=0
aeron-rel-invoker.knob.term_length=1048576
dpdk-aeron-rel.knob.aeron_driver=external
dpdk-aeron-rel.knob.aeron_page=4096
dpdk-aeron-rel.knob.aeron_threading=DEDICATED
dpdk-aeron-rel.knob.nak_delay_ns=1000
dpdk-aeron-rel.knob.rx_free_thresh=pmd
dpdk-aeron-rel.knob.term_length=1048576
dpdk-aeron-rel-emb.knob.aeron_driver=embedded
dpdk-aeron-rel-emb.knob.aeron_page=4096
dpdk-aeron-rel-emb.knob.aeron_threading=DEDICATED
dpdk-aeron-rel-emb.knob.nak_delay_ns=1000
dpdk-aeron-rel-emb.knob.rx_free_thresh=pmd
dpdk-aeron-rel-emb.knob.term_length=1048576
dpdk-aeron-rel-invoker.knob.aeron_driver=embedded
dpdk-aeron-rel-invoker.knob.aeron_page=4096
dpdk-aeron-rel-invoker.knob.aeron_threading=INVOKER
dpdk-aeron-rel-invoker.knob.nak_delay_ns=1000
dpdk-aeron-rel-invoker.knob.rx_free_thresh=pmd
dpdk-aeron-rel-invoker.knob.term_length=1048576
dpdk-aeron-rel-shared.knob.aeron_driver=external
dpdk-aeron-rel-shared.knob.aeron_page=4096
dpdk-aeron-rel-shared.knob.aeron_threading=SHARED
dpdk-aeron-rel-shared.knob.nak_delay_ns=1000
dpdk-aeron-rel-shared.knob.rx_free_thresh=pmd
dpdk-aeron-rel-shared.knob.term_length=1048576
dpdk-aeron-rel-shnet.knob.aeron_driver=external
dpdk-aeron-rel-shnet.knob.aeron_page=4096
dpdk-aeron-rel-shnet.knob.aeron_threading=SHARED_NETWORK
dpdk-aeron-rel-shnet.knob.nak_delay_ns=1000
dpdk-aeron-rel-shnet.knob.rx_free_thresh=pmd
dpdk-aeron-rel-shnet.knob.term_length=1048576
# each arm's technology's best napi_defer (TR_BEST_BY_TECHNOLOGY)
best.knob.napi_defer=aeron-rel:0,aeron-rel-emb:0,aeron-rel-invoker:0
# each declared twin and the one knob it differs from its twin in (TR_DECLARED)
declared.dpdk-aeron-rel-emb=dpdk-aeron-rel:knob.aeron_driver
declared.dpdk-aeron-rel-shnet=dpdk-aeron-rel:knob.aeron_threading
declared.dpdk-aeron-rel-shared=dpdk-aeron-rel:knob.aeron_threading
declared.dpdk-aeron-rel-invoker=dpdk-aeron-rel-emb:knob.aeron_threading
declared.aeron-rel-emb=aeron-rel:knob.aeron_driver
declared.aeron-rel-invoker=aeron-rel-emb:knob.aeron_threading
