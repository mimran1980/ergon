# transport_collect.py: transport-settings.tr.env's sysctls (host.sh transport_sysctls),
# each the value every host must read back at every point; an optional one no host's
# kernel had at any point is declared absent
shared.net.ipv4.tcp_congestion_control=cubic
shared.net.ipv4.tcp_sack=1
shared.net.ipv4.tcp_timestamps=1
shared.net.ipv4.tcp_slow_start_after_idle=0
shared.net.ipv4.tcp_rmem=4096 1048576 16777216
shared.net.ipv4.tcp_wmem=4096 1048576 16777216
shared.net.core.rmem_max=16777216
shared.net.core.wmem_max=16777216
shared.net.core.busy_read=50
shared.net.core.busy_poll=50
shared.net.ipv4.tcp_rto_min_us=8000
shared.net.ipv4.tcp_delack_max_us=absent
shared.devices.system.cpu.smt.active=0
# each arm's per-arm knobs as it ran them (transport-settings.env's list); a sweep
# line names the arms a tuning session swept for one (TR_TUNED_SWEPT, its variants)
aeron-mix.knob.aeron_driver=external
aeron-mix.knob.aeron_page=4096
aeron-mix.knob.aeron_path=kernel-busy
aeron-mix.knob.aeron_so_rcvbuf=2097152
aeron-mix.knob.aeron_threading=DEDICATED
aeron-mix.knob.nak_delay_ns=1000
aeron-mix.knob.napi_defer=0
aeron-mix.knob.term_length=1048576
aeron-mix-invoker.knob.aeron_driver=embedded
aeron-mix-invoker.knob.aeron_page=4096
aeron-mix-invoker.knob.aeron_path=kernel-busy
aeron-mix-invoker.knob.aeron_so_rcvbuf=2097152
aeron-mix-invoker.knob.aeron_threading=INVOKER
aeron-mix-invoker.knob.nak_delay_ns=1000
aeron-mix-invoker.knob.napi_defer=0
aeron-mix-invoker.knob.term_length=1048576
aeron-mix-shared.knob.aeron_driver=external
aeron-mix-shared.knob.aeron_page=4096
aeron-mix-shared.knob.aeron_path=kernel-busy
aeron-mix-shared.knob.aeron_so_rcvbuf=2097152
aeron-mix-shared.knob.aeron_threading=SHARED
aeron-mix-shared.knob.nak_delay_ns=1000
aeron-mix-shared.knob.napi_defer=0
aeron-mix-shared.knob.term_length=1048576
mio-udp.knob.busy_read_us=50
mio-udp.knob.epoll_events=64
mio-udp.knob.irq_idle=all
mio-udp.knob.napi_defer=0
mio-udp.knob.sockbuf=2097152
# each arm's technology's best napi_defer (TR_BEST_BY_TECHNOLOGY)
best.knob.napi_defer=aeron-mix:0,aeron-mix-invoker:0,aeron-mix-shared:0,mio-udp:0
# each declared twin and the one knob it differs from its twin in (TR_DECLARED)
declared.aeron-mix-shared=aeron-mix:knob.aeron_threading
declared.aeron-mix-invoker=aeron-mix-emb:knob.aeron_threading
