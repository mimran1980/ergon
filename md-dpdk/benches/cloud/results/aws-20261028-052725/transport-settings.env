# transport_collect.py: transport-settings.tr.env's sysctls (host.sh transport_sysctls),
# each the value every host must read back at every point; an optional one no host's
# kernel had at any point is declared absent
shared.net.ipv4.tcp_congestion_control=cubic
shared.net.ipv4.tcp_sack=1
shared.net.ipv4.tcp_timestamps=1
shared.net.ipv4.tcp_slow_start_after_idle=0
shared.net.ipv4.tcp_rmem=4096 1048576 16777216
shared.net.ipv4.tcp_wmem=4096 1048576 16777216
shared.net.core.rmem_max=16777216
shared.net.core.wmem_max=16777216
shared.net.core.busy_read=50
shared.net.core.busy_poll=50
shared.net.ipv4.tcp_rto_min_us=8000
shared.net.ipv4.tcp_delack_max_us=absent
# each arm's per-arm knobs as it ran them (transport-settings.env's list); a sweep
# line names the arms a tuning session swept for one (TR_TUNED_SWEPT, its variants)
aeron-spy.knob.aeron_page=4096
aeron-spy.knob.term_length=1048576
aeron-spy-udp.knob.aeron_page=4096
aeron-spy-udp.knob.term_length=1048576
dpdk-aeron-spy-udp.knob.aeron_page=4096
dpdk-aeron-spy-udp.knob.rx_free_thresh=pmd
dpdk-aeron-spy-udp.knob.term_length=1048576
