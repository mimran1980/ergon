# transport_collect.py: transport-settings.tr.env's sysctls (host.sh transport_sysctls),
# each the value every host must read back at every point; an optional one no host's
# kernel had at any point is declared absent
shared.net.ipv4.tcp_congestion_control=cubic
shared.net.ipv4.tcp_sack=1
shared.net.ipv4.tcp_timestamps=1
shared.net.ipv4.tcp_slow_start_after_idle=0
shared.net.ipv4.tcp_autocorking=0
shared.net.ipv4.tcp_rmem=4096 1048576 16777216
shared.net.ipv4.tcp_wmem=4096 1048576 16777216
shared.net.core.rmem_max=16777216
shared.net.core.wmem_max=16777216
shared.net.core.busy_read=50
shared.net.core.busy_poll=50
shared.net.ipv4.tcp_rto_min_us=8000
shared.net.ipv4.tcp_delack_max_us=absent
shared.devices.system.cpu.smt.active=0
# each arm's per-arm knobs as it ran them (transport-settings.env's list); a sweep
# line names the arms a tuning session swept for one (TR_TUNED_SWEPT, its variants)
dpdk-aeron-mix.knob.aeron_driver=external
dpdk-aeron-mix.knob.aeron_page=4096
dpdk-aeron-mix.knob.aeron_threading=DEDICATED
dpdk-aeron-mix.knob.irq_idle=all
dpdk-aeron-mix.knob.nak_delay_ns=1000
dpdk-aeron-mix.knob.rx_free_thresh=pmd
dpdk-aeron-mix.knob.term_length=1048576
dpdk-aeron-mix-emb.knob.aeron_driver=embedded
dpdk-aeron-mix-emb.knob.aeron_page=4096
dpdk-aeron-mix-emb.knob.aeron_threading=DEDICATED
dpdk-aeron-mix-emb.knob.irq_idle=all
dpdk-aeron-mix-emb.knob.nak_delay_ns=1000
dpdk-aeron-mix-emb.knob.rx_free_thresh=pmd
dpdk-aeron-mix-emb.knob.term_length=1048576
dpdk-aeron-mix-invoker.knob.aeron_driver=embedded
dpdk-aeron-mix-invoker.knob.aeron_page=4096
dpdk-aeron-mix-invoker.knob.aeron_threading=INVOKER
dpdk-aeron-mix-invoker.knob.irq_idle=all
dpdk-aeron-mix-invoker.knob.nak_delay_ns=1000
dpdk-aeron-mix-invoker.knob.rx_free_thresh=pmd
dpdk-aeron-mix-invoker.knob.term_length=1048576
dpdk-aeron-mix-shared.knob.aeron_driver=external
dpdk-aeron-mix-shared.knob.aeron_page=4096
dpdk-aeron-mix-shared.knob.aeron_threading=SHARED
dpdk-aeron-mix-shared.knob.irq_idle=all
dpdk-aeron-mix-shared.knob.nak_delay_ns=1000
dpdk-aeron-mix-shared.knob.rx_free_thresh=pmd
dpdk-aeron-mix-shared.knob.term_length=1048576
dpdk-aeron-mix-shnet.knob.aeron_driver=external
dpdk-aeron-mix-shnet.knob.aeron_page=4096
dpdk-aeron-mix-shnet.knob.aeron_threading=SHARED_NETWORK
dpdk-aeron-mix-shnet.knob.irq_idle=all
dpdk-aeron-mix-shnet.knob.nak_delay_ns=1000
dpdk-aeron-mix-shnet.knob.rx_free_thresh=pmd
dpdk-aeron-mix-shnet.knob.term_length=1048576
dpdk-raw.knob.irq_idle=all
mio-udp.knob.busy_read_us=50
mio-udp.knob.epoll_events=64
mio-udp.knob.irq_idle=all
mio-udp.knob.napi_defer=0
mio-udp.knob.sockbuf=2097152
# each arm's technology's best napi_defer (TR_BEST_BY_TECHNOLOGY)
best.knob.napi_defer=mio-udp:0
# each declared twin and the one knob it differs from its twin in (TR_DECLARED)
declared.dpdk-aeron-mix-emb=dpdk-aeron-mix:knob.aeron_driver
declared.dpdk-aeron-mix-shnet=dpdk-aeron-mix:knob.aeron_threading
declared.dpdk-aeron-mix-shared=dpdk-aeron-mix:knob.aeron_threading
declared.dpdk-aeron-mix-invoker=dpdk-aeron-mix-emb:knob.aeron_threading
