# transport_collect.py: transport-settings.tr.env's sysctls (host.sh transport_sysctls),
# each the value every host must read back at every point; an optional one no host's
# kernel had at any point is declared absent
shared.net.ipv4.tcp_congestion_control=cubic
shared.net.ipv4.tcp_sack=1
shared.net.ipv4.tcp_timestamps=1
shared.net.ipv4.tcp_slow_start_after_idle=0
shared.net.ipv4.tcp_autocorking=0
shared.net.ipv4.tcp_rmem=4096 1048576 16777216
shared.net.ipv4.tcp_wmem=4096 1048576 16777216
shared.net.core.rmem_max=16777216
shared.net.core.wmem_max=16777216
shared.net.core.busy_read=50
shared.net.core.busy_poll=50
shared.net.ipv4.tcp_rto_min_us=8000
shared.net.ipv4.tcp_delack_max_us=absent
shared.devices.system.cpu.smt.active=0
# each arm's per-arm knobs as it ran them (transport-settings.env's list); a sweep
# line names the arms a tuning session swept for one (TR_TUNED_SWEPT, its variants)
io-tcp-epoll.knob.irq_idle=all
io-tcp-epoll.knob.napi_defer=0
io-tcp-fstack.knob.irq_idle=all
io-tcp-fstack.knob.napi_defer=0
io-tcp-fstack.knob.rto_min_us=8000
io-tcp-fstack.knob.sockbuf=2097152
io-tcp-smol.knob.irq_idle=all
io-tcp-smol.knob.napi_defer=0
io-udp-epoll.knob.busy_read_us=50
io-udp-epoll.knob.datagram_burst=64
io-udp-epoll.knob.epoll_events=64
io-udp-epoll.knob.irq_idle=all
io-udp-epoll.knob.napi_defer=0
io-udp-epoll.knob.sockbuf=2097152
io-udp-smol.knob.busy_read_us=50
io-udp-smol.knob.datagram_burst=64
io-udp-smol.knob.epoll_events=64
io-udp-smol.knob.irq_idle=all
io-udp-smol.knob.napi_defer=0
io-udp-smol.knob.sockbuf=2097152
io-ws-epoll.knob.irq_idle=all
io-ws-epoll.knob.napi_defer=0
io-ws-fstack.knob.irq_idle=all
io-ws-fstack.knob.napi_defer=0
io-ws-smol.knob.irq_idle=all
io-ws-smol.knob.napi_defer=0
# each arm's technology's best napi_defer (TR_BEST_BY_TECHNOLOGY)
best.knob.napi_defer=io-tcp-epoll:0,io-tcp-fstack:0,io-tcp-smol:0,io-udp-epoll:0,io-udp-smol:0,io-ws-epoll:0,io-ws-fstack:0,io-ws-smol:0
