# transport_collect.py: transport-settings.tr.env's sysctls (host.sh transport_sysctls),
# each the value every host must read back at every point; an optional one no host's
# kernel had at any point is declared absent
shared.net.ipv4.tcp_congestion_control=cubic
shared.net.ipv4.tcp_sack=1
shared.net.ipv4.tcp_timestamps=1
shared.net.ipv4.tcp_slow_start_after_idle=0
shared.net.ipv4.tcp_autocorking=0
shared.net.ipv4.tcp_rmem=4096 1048576 16777216
shared.net.ipv4.tcp_wmem=4096 1048576 16777216
shared.net.core.rmem_max=16777216
shared.net.core.wmem_max=16777216
shared.net.core.busy_read=50
shared.net.core.busy_poll=50
shared.net.ipv4.tcp_rto_min_us=8000
shared.net.ipv4.tcp_delack_max_us=absent
shared.devices.system.cpu.smt.active=0
# each arm's per-arm knobs as it ran them (transport-settings.env's list); a sweep
# line names the arms a tuning session swept for one (TR_TUNED_SWEPT, its variants)
dpdk-aeron-udp.knob.aeron_driver=external
dpdk-aeron-udp.knob.aeron_page=4096
dpdk-aeron-udp.knob.aeron_threading=DEDICATED
dpdk-aeron-udp.knob.irq_idle=all
dpdk-aeron-udp.knob.rx_free_thresh=pmd
dpdk-aeron-udp.knob.term_length=1048576
dpdk-aeron-udp-b8.knob.aeron_driver=external
dpdk-aeron-udp-b8.knob.aeron_page=4096
dpdk-aeron-udp-b8.knob.aeron_threading=DEDICATED
dpdk-aeron-udp-b8.knob.irq_idle=all
dpdk-aeron-udp-b8.knob.rx_free_thresh=pmd
dpdk-aeron-udp-b8.knob.term_length=1048576
eio-udp.knob.busy_read_us=50
eio-udp.knob.datagram_burst=64
eio-udp.knob.epoll_events=64
eio-udp.knob.irq_idle=all
eio-udp.knob.napi_defer=0
eio-udp.knob.sockbuf=2097152
eio-udp-b8.knob.busy_read_us=50
eio-udp-b8.knob.datagram_burst=64
eio-udp-b8.knob.epoll_events=64
eio-udp-b8.knob.irq_idle=all
eio-udp-b8.knob.napi_defer=0
eio-udp-b8.knob.sockbuf=2097152
eio-udp-smol.knob.busy_read_us=50
eio-udp-smol.knob.datagram_burst=64
eio-udp-smol.knob.epoll_events=64
eio-udp-smol.knob.irq_idle=all
eio-udp-smol.knob.napi_defer=0
eio-udp-smol.knob.sockbuf=2097152
eio-udp-smol-b8.knob.busy_read_us=50
eio-udp-smol-b8.knob.datagram_burst=64
eio-udp-smol-b8.knob.epoll_events=64
eio-udp-smol-b8.knob.irq_idle=all
eio-udp-smol-b8.knob.napi_defer=0
eio-udp-smol-b8.knob.sockbuf=2097152
# each arm's technology's best napi_defer (TR_BEST_BY_TECHNOLOGY)
best.knob.napi_defer=eio-udp:0,eio-udp-b8:0,eio-udp-smol:0,eio-udp-smol-b8:0
