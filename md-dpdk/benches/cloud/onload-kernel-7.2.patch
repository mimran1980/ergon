diff --git a/src/include/ci/tools/platform/linux_kernel.h b/src/include/ci/tools/platform/linux_kernel.h
index 27857b03..2d46ad30 100644
--- a/src/include/ci/tools/platform/linux_kernel.h
+++ b/src/include/ci/tools/platform/linux_kernel.h
@@ -65,6 +65,21 @@
 
 #include <ci/tools/config.h>
 
+#ifdef EFRM_NEED_STRNCPY
+/* Linux 7.2 removed strncpy(); Onload's kernel code still calls it.  The
+ * same semantics: copy at most n bytes, then pad with NUL to n. */
+static inline char* ci_compat_strncpy(char* dst, const char* src, size_t n)
+{
+  size_t i = 0;
+  for( ; i < n && src[i] != '\0'; ++i )
+    dst[i] = src[i];
+  for( ; i < n; ++i )
+    dst[i] = '\0';
+  return dst;
+}
+#define strncpy ci_compat_strncpy
+#endif
+
 #define ci_in_atomic     in_atomic
 
 
