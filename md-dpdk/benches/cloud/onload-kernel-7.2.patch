diff --git a/src/lib/cplane/uapi_resolve.c b/src/lib/cplane/uapi_resolve.c
index 2c5d72b8..90066d2e 100644
--- a/src/lib/cplane/uapi_resolve.c
+++ b/src/lib/cplane/uapi_resolve.c
@@ -5,7 +5,23 @@
 #include <netinet/ip.h>
 #include <netinet/ip6.h>
 #include <endian.h>
+#if defined(__x86_64__) || defined(__i386__)
 #include <immintrin.h>
+#else
+/* BMI2's pdep, bit by bit: deposit the low bits of src at the set bits of
+ * mask, lowest first */
+static inline uint32_t _pdep_u32(uint32_t src, uint32_t mask)
+{
+  uint32_t out = 0, bit;
+  for( bit = 1; mask != 0; bit <<= 1 ) {
+    uint32_t lowest = mask & -mask;
+    if( src & bit )
+      out |= lowest;
+    mask &= mask - 1;
+  }
+  return out;
+}
+#endif
 
