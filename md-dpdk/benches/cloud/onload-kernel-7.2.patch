@@ -992,7 +992,16 @@ int efab_tcp_helper_set_tcp_close_os_sock(tcp_helper_resource_t *thr,
   sock = get_linux_socket(ep);
   if( sock == NULL )
     return  -EINVAL;
+#ifdef EFRM_HAVE_TCP_SET_STATE_EXPORT
   tcp_set_state(sock->sk, TCP_CLOSE);
+#else
+  /* Linux 7.2 no longer exports tcp_set_state().  Its TCP_CLOSE work that a
+   * module can still do: unhash, then the state.  Not done: the CurrEstab
+   * counter and inet_put_port() for a port the OS chose (only after a failed
+   * connect(), the one caller). */
+  sock->sk->sk_prot->unhash(sock->sk);
+  inet_sk_set_state(sock->sk, TCP_CLOSE);
+#endif
   put_linux_socket(sock);
   return 0;
 }
