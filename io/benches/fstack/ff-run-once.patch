+/* ergon: one pass of the loop ff_run runs (timers, TX drain, RX and the
+ * stack, HPTS), with no user callback, on the calling lcore thread. A
+ * pass always drains TX (pkt_tx_delay does not apply). Not for
+ * graceful_reload or thread_mode=1. */
+int
+ff_run_once(void)
+{
+    static __thread struct loop_routine lr;
+
+    ff_once = 1;
+    main_loop(&lr);
+    ff_once = 0;
+    return 0;
+}
