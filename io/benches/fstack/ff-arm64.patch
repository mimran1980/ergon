diff --git a/mk/kern.pre.mk b/mk/kern.pre.mk
index 2141a039..c25d4835 100644
--- a/mk/kern.pre.mk
+++ b/mk/kern.pre.mk
@@ -28,6 +28,14 @@ COPTFLAGS?=-O2 -fno-strict-aliasing -frename-registers -pipe -Wno-maybe-uninitia
 else
 COPTFLAGS?=-O2 -pipe
 endif
+else ifeq (${MACHINE_CPUARCH},aarch64)
+# ergon: GCC 14 on arm64 flags the same false positives as on amd64, and
+# more (fields read only under a flag, e.g. tcp_output's to.to_tsval)
+ifneq (${COMPILER_TYPE},clang)
+COPTFLAGS?=-O2 -fno-strict-aliasing -frename-registers -pipe -Wno-maybe-uninitialized -Wno-error=uninitialized
+else
+COPTFLAGS?=-O2 -pipe
+endif
 else
 COPTFLAGS?=${_MINUS_O} -pipe
 endif
