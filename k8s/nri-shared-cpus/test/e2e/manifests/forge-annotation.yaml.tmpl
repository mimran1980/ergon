# SPDX-License-Identifier: Apache-2.0
#
# Forge pod, annotation path: the pod opt-in annotation is set and the env
# matches its millicpu request, but the claimed "shared" CPU is another pod's
# exclusive CPU, which is outside sharedCpus. The union may only add CPUs
# from sharedCpus, so this pod must not be widened onto it.
#
# @@E0@@ is replaced with an exclusive CPU of pod A at apply time.
apiVersion: v1
kind: Pod
metadata:
  name: forge-annotation
  namespace: ergon-e2e
  annotations:
    cpu-shared.ergon.io/app: "250"
spec:
  restartPolicy: Never
  nodeSelector:
    ergon.io/shared-cpus: "true"
  containers:
    - name: app
      image: ergon-nri-pin-test:e2e
      imagePullPolicy: Never
      command: ["sleep", "infinity"]
      env:
        - name: ERGON_ISOLATED_CPUS
          value: "99"
        - name: ERGON_SHARED_CPUS
          value: "@@E0@@"
        - name: ERGON_SHARED_MILLICPUS
          value: "250"
        - name: ERGON_HELPER_CPUS
          value: "@@E0@@"
      resources:
        requests:
          cpu: "1"
          memory: 32Mi
        limits:
          cpu: "1"
          memory: 32Mi
